# =============================================================================
# PIMO — variáveis de ambiente (EXEMPLO — sem valores secretos)
# Copiar para .env (local) — NUNCA commitar .env / .env.production com secrets.
# =============================================================================

# --- CLIENT-SAFE (Vite: expostas no bundle) ---
# URL base da API (auth/users/settings). Em Hostinger same-origin pode ficar vazio.
# Em LOCAL: preferir vazio/same-origin; NÃO apontar para Production por omissão.
VITE_API_URL=
VITE_TEXTURES_URL=

# Ambiente declarado no cliente (opcional). Em `npm run dev` assume-se local.
# Builds: staging | production | preview
# VITE_PIMO_APP_ENV=production

# Proxy /api no Vite DEV — DEFAULT desligado (não usa pimo.pro).
# Ex.: http://127.0.0.1:8080 ou URL de staging. Production só com flag explícita.
# VITE_DEV_API_PROXY_TARGET=
# VITE_ALLOW_DEV_PROXY_PRODUCTION=false

# Full Local Development Access (só Vite DEV). Desligar: false
# VITE_ALLOW_FULL_LOCAL_DEV_ACCESS=true

# Supabase industrial (anon/publishable) — público por natureza do Vite.
# Seguro APENAS com RLS correcto (Phase 1). Não commitar valores reais.
# Preferir projecto STAGING em desenvolvimento; Production só em builds de prod.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 1: writes directos Supabase no browser. Em PROD default=off.
# Em DEV default=on até BFF. Forçar: true|false
# VITE_INDUSTRIAL_SUPABASE_DIRECT_WRITES=false

# Opcional: desligar K/K mesmo em `npm run dev` (VITE_ALLOW_LOCAL_DEV_AUTH=false)
# VITE_ALLOW_LOCAL_DEV_AUTH=true

# --- SERVER-ONLY (PHP Hostinger / nunca VITE_*) ---
# Ambiente: local | development | staging | production | preview
# Ausente ou desconhecido = production (fail-closed).
PIMO_APP_ENV=production

# JWT HS256 — OBRIGATÓRIO em staging/production/preview (≥32 caracteres aleatórios).
# Em local/development: se ausente, usa PIMO_JWT_SECRET_LOCAL ou material LOCAL-ONLY do PHP.
PIMO_JWT_SECRET=

# Opcional em local/development quando PIMO_JWT_SECRET não está definido.
# PIMO_JWT_SECRET_LOCAL=

# Seed admin@pimo.local / admin123 — só tem efeito com PIMO_APP_ENV=local|development.
# Em local: activo por omissão; desligar com 0. Em production: ignorado (nunca cria).
# PIMO_ALLOW_DEFAULT_ADMIN=1

# Secret do proxy de orçamentos (api/quotes) → pimo-mail-service. NUNCA VITE_*.
PIMO_INTERNAL_API_SECRET=

# --- Migrations (scripts/applyMigrationsPg.mjs) — SERVER-ONLY ---
# Obrigatório: local | staging | production
# PIMO_MIGRATE_TARGET=staging
#
# Allowlist CANÓNICA (código — migrateTargetGuard.mjs):
#   STAGING    = rszpnvmscehqapflaklv
#   PRODUCTION = ritmrjwrmcsofyugviil
# URLs esperadas:
#   https://rszpnvmscehqapflaklv.supabase.co
#   https://ritmrjwrmcsofyugviil.supabase.co
#
# LOCAL exige project ref dedicado (NÃO staging/production):
# PIMO_SUPABASE_PROJECT_REF_LOCAL=
#
# Credenciais do MESMO projecto que o target (nunca misturar):
# DATABASE_URL=
# SUPABASE_PROJECT_REF=
# VITE_SUPABASE_URL=
#
# Production only:
# CONFIRM_PRODUCTION_MIGRATE=I_UNDERSTAND
# Dry-run:
# PIMO_MIGRATE_DRY_RUN=1
#
# Precedência de ficheiros: .env + (.env.staging | .env.production conforme target) + process.env
# Nunca carregar .env.production quando target=staging.

# Sync GitHub de projetos (opcional)
# PIMO_GITHUB_PROJECTS_TOKEN=
# PIMO_GITHUB_PROJECTS_SYNC=

# --- SERVER-ONLY futuro / email (ainda não ligados ao auth) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# REMOVIDO do frontend (Phase 0):
# VITE_INTERNAL_API_SECRET — era injectado no bundle; usar PIMO_INTERNAL_API_SECRET no PHP.
