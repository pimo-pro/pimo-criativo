<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Auth API — tem de vir ANTES do fallback SPA (senão /me e /auth/login vão para index.html)
  RewriteRule ^auth/login$ api/auth/index.php [L]
  RewriteRule ^auth/register$ api/auth/index.php [L]
  RewriteRule ^auth/verify-email$ api/auth/index.php [L]
  RewriteRule ^me$ api/auth/index.php [L]
  RewriteRule ^users$ api/users/index.php [L]
  RewriteRule ^project-shares$ api/project-shares/index.php [L]
  RewriteRule ^invite-codes$ api/invite-codes/index.php [L]
  RewriteRule ^user/settings$ api/user-settings/index.php [L]

  # PATCH/OPTIONS /config/global → API autenticada.
  RewriteCond %{REQUEST_METHOD} ^(PATCH|OPTIONS)$
  RewriteRule ^config/global$ api/global-config/index.php [L]

  # GET/HEAD /config/global → ficheiro estático.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^config/global$ config/global.json [L]

  # Assets Vite: se o ficheiro não existir, 404 real (NUNCA index.html / MIME text/html)
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_URI} ^/config/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_URI} ^/updates/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
