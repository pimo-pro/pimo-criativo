+    const ext = remates.find((r) => r.partIndex === 1)!;
+    const int = remates.find((r) => r.partIndex === 2)!;
+
+    expect(ext.faceOffsets).toBeUndefined();
+    expect(int.faceOffsets).toBeUndefined();
