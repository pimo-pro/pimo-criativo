exports[`IndustrialModelsPage Fase F > snapshot estável 1`] = `"<div data-testid="industrial-models-page" style="display:flex;flex-direction:column;gap:16px;min-height:0"><header><h1 style="margin:0;font-size:20px;font-weight:700">Industrial Models</h1><p style="margin:6px 0 0;font-size:12px;color:var(--text-muted)">Registo somente leitura dos modos industriais (Fases A–D). Sem edição nesta fase.</p></header><section aria-label="Lista de modos industriais"><div style="overflow-x:auto"><table data-testid="industrial-models-table" style="width:100%;border-collapse:collapse;font-size:12px;color:var(--admin-text, var(--text-main))"><thead><tr><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Modelo</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Fase</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Peças industriais</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Regras</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Adapters</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Dependências</th><th style="text-align:left;padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.12);white-space:nowrap;font-weight:600">Sync/Adapter order</th></tr></thead><tbody><tr data-testid="industrial-model-row-cx_gav_cavita"><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top"><div style="font-weight:600">Caixa cavita (cx_gav)</div><div style="color:var(--text-muted);margin-top:2px">cx_gav_cavita</div></td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">A</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">cx_gav_lat_dir, cx_gav_lat_esq, cx_gav_fun, cx_gav_cima</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">profundidade_ssot, naming_industrial, orla_industrial, routing_drill_cnc, furos_cx_gav_10x30_10x13</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">cxGavCutlistAdapter, cxGavDrilling</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">profundidadeSsot</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sync — / adapter 10</td></tr><tr data-testid="industrial-model-row-gaveta_porta_sep_prateleiras"><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top"><div style="font-weight:600">Gaveta embutida + porta + SEP + prateleiras</div><div style="color:var(--text-muted);margin-top:2px">gaveta_porta_sep_prateleiras</div></td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">B</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">separador, gaveta_frente_ext, porta_simples, prateleira</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">folga_2mm_gaveta_porta, naming_industrial, orla_industrial, routing_drill_cnc</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">gavetaPortaSepLayout, drawerCutlistAdapter, doorLabels</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sep, gavetas, portas</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sync 10 / adapter 20</td></tr><tr data-testid="industrial-model-row-wardrobe_sep_parcial_gavetas"><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top"><div style="font-weight:600">SEP parcial → DIV (só cavilha)</div><div style="color:var(--text-muted);margin-top:2px">wardrobe_sep_parcial_gavetas</div></td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">C</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">separador, divisorio, gaveta_frente_ext</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sep_parcial_div_so_cavilha, naming_industrial, orla_industrial, routing_drill_cnc</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">partialSepToDiv, divSep/drilling</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sep, div, gavetas</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sync 20 / adapter —</td></tr><tr data-testid="industrial-model-row-inner_cabinet_a1"><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top"><div style="font-weight:600">Caixa interna dinâmica a_1</div><div style="color:var(--text-muted);margin-top:2px">inner_cabinet_a1</div><div style="margin-top:4px;font-size:11px;color:var(--text-muted)">skipClassicDrawerCutlist</div></td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">D</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">a1_cx_lat_dir, a1_cx_lat_esq, a1_cx_cima, a1_cx_fundo, a1_cx_comp_40, gaveta_frente_ext, gaveta_lat_dir, gaveta_lat_esq, gaveta_fundo, gaveta_traseira</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">profundidade_ssot, compensacao_40mm, naming_industrial, orla_industrial, routing_drill_cnc, gavetas_europeias_internas</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">a1CutlistAdapter, hingeCompensation40, a1Naming, drawerCutlistAdapter</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sep, div, gavetas, compensacao40, profundidadeSsot</td><td style="padding:8px 10px;border-bottom:1px solid rgba(255,255,255,0.08);vertical-align:top">sync — / adapter 30</td></tr></tbody></table></div></section><p style="margin:0;font-size:11px;color:var(--text-muted)">4 modo(s) registado(s)</p></div>"`;
